# Copy to .env.local and fill in. Every key is optional:
# without them Bonum runs in pure local-first mode (IndexedDB only).

# --- Notion two-way sync -------------------------------------------------
# Internal integration secret from https://www.notion.so/my-integrations
NOTION_API_KEY=
# The Axioms database (share it with your integration). 32-char id from its URL.
NOTION_AXIOMS_DB_ID=
# Optional: the Pillars database. When set, the Axioms "Pillar" relation is
# resolved against it by page title (Relatio, Habitus, ...).
NOTION_PILLARS_DB_ID=

# --- Socratic Adversary (optional LLM challenges in The Forge) ------------
ANTHROPIC_API_KEY=
